{
  "manifest_version": 1,
  "type": "device",
  "name": "Tvheadend",
  "description": {
    "en": "Your Tvheadend recorder in Gladys: recordings, free space, viewers, and scenes on each recording.",
    "fr": "Votre enregistreur Tvheadend dans Gladys : enregistrements, place libre, lectures et scènes.",
    "de": "Dein Tvheadend-Rekorder in Gladys: Aufnahmen, freier Speicher, Zuschauer und Szenen.",
    "es": "Su grabador Tvheadend en Gladys: grabaciones, espacio libre, reproducciones y escenas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-tvheadend:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-tvheadend/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Tvheadend server",
        "fr": "Votre serveur Tvheadend",
        "de": "Dein Tvheadend-Server",
        "es": "Su servidor Tvheadend"
      },
      "description": {
        "en": "Enter the address of Tvheadend (port 9981) and an account with the video recorder and web interface rights. An admin account also shows the viewers and the tuners in use. The server appears in the Discover tab.",
        "fr": "Saisissez l'adresse de Tvheadend (port 9981) et un compte avec les droits d'enregistrement et d'interface web. Un compte administrateur montre aussi les lectures et les tuners utilisés. Le serveur apparaît dans l'onglet Découverte.",
        "de": "Gib die Adresse von Tvheadend (Port 9981) und ein Konto mit Aufnahme- und Weboberflächen-Rechten ein. Ein Administratorkonto zeigt auch Zuschauer und belegte Tuner. Der Server erscheint im Tab „Entdecken“.",
        "es": "Introduzca la dirección de Tvheadend (puerto 9981) y una cuenta con derechos de grabación e interfaz web. Una cuenta de administrador muestra también las reproducciones y los sintonizadores en uso. El servidor aparece en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-tvheadend/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://docs.tvheadend.org/",
          "label": {
            "en": "Tvheadend documentation",
            "fr": "Documentation de Tvheadend",
            "de": "Tvheadend-Dokumentation",
            "es": "Documentación de Tvheadend"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Tvheadend address",
        "fr": "Adresse de Tvheadend",
        "de": "Tvheadend-Adresse",
        "es": "Dirección de Tvheadend"
      },
      "description": {
        "en": "Address of the web interface of Tvheadend (port 9981 by default).",
        "fr": "Adresse de l'interface web de Tvheadend (port 9981 par défaut).",
        "de": "Adresse der Weboberfläche von Tvheadend (standardmäßig Port 9981).",
        "es": "Dirección de la interfaz web de Tvheadend (puerto 9981 por defecto)."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:9981",
        "fr": "ex. http://192.168.1.2:9981",
        "de": "z. B. http://192.168.1.2:9981",
        "es": "p. ej. http://192.168.1.2:9981"
      },
      "required": true
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "User name",
        "fr": "Identifiant",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "A Tvheadend user (Configuration → Users → Access entries).",
        "fr": "Un utilisateur de Tvheadend (Configuration → Utilisateurs → Accès).",
        "de": "Ein Tvheadend-Benutzer (Konfiguration → Benutzer → Zugangseinträge).",
        "es": "Un usuario de Tvheadend (Configuración → Usuarios → Entradas de acceso)."
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": true
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Tvheadend is read: a few light requests each time.",
        "fr": "À quelle fréquence Tvheadend est lu : quelques requêtes légères à chaque fois.",
        "de": "Wie oft Tvheadend gelesen wird: jedes Mal ein paar leichte Anfragen.",
        "es": "Con qué frecuencia se lee Tvheadend: unas pocas peticiones ligeras cada vez."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when the device is added), of the dates and of the scene results.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout de l'appareil), des dates et des résultats de scène.",
        "de": "Sprache der Funktionsnamen (beim Anlegen des Geräts festgelegt), der Daten und der Szenen-Ergebnisse.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir el dispositivo), de las fechas y de los resultados de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "recording_started",
      "label": {
        "en": "A recording starts",
        "fr": "Un enregistrement démarre",
        "de": "Eine Aufnahme startet",
        "es": "Empieza una grabación"
