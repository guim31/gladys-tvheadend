      "description": {
        "en": "Tvheadend starts recording a programme.",
        "fr": "Tvheadend commence à enregistrer un programme.",
        "de": "Tvheadend beginnt, eine Sendung aufzunehmen.",
        "es": "Tvheadend empieza a grabar un programa."
      },
      "fields": [
        {
          "key": "channel",
          "type": "string",
          "label": {
            "en": "Channel (optional)",
            "fr": "Chaîne (facultatif)",
            "de": "Sender (optional)",
            "es": "Canal (opcional)"
          },
          "description": {
            "en": "The channel name as Tvheadend shows it. Empty: every channel.",
            "fr": "Le nom de la chaîne tel que Tvheadend l'affiche. Vide : toutes les chaînes.",
            "de": "Der Sendername, wie Tvheadend ihn anzeigt. Leer: alle Sender.",
            "es": "El nombre del canal tal como lo muestra Tvheadend. Vacío: todos los canales."
          },
          "required": false
